#!/bin/sh
# Hivemind Swarm v2.5 stack + topology switcher (macOS / Linux / WSL).
#
# Thin POSIX launcher. Switching, status, list, validate, model-tier preflight,
# and skill staging all live in bin/hive-switch.cjs so every platform shares one
# implementation. The managed roster includes "pr-reviewer" and
# "swarm-agent-updater"; install.sh stages their skill/engine copies under
# $HIVEMIND_HOME/skills.
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
HIVEMIND_HOME="${HIVEMIND_HOME:-$HOME/.config/hivemind}"

BACKEND=""
for candidate in \
  "$HIVEMIND_HOME/bin/hive-switch.cjs" \
  "$SCRIPT_DIR/hive-switch.cjs" \
  "$SCRIPT_DIR/../bin/hive-switch.cjs"
do
  if [ -f "$candidate" ]; then
    BACKEND="$candidate"
    break
  fi
done

if [ -z "$BACKEND" ]; then
  echo "[hive-switch] ERROR: missing bin/hive-switch.cjs. Re-run install.sh to install the switcher backend into $HIVEMIND_HOME." >&2
  exit 1
fi

NODE=""
if [ -n "${HIVEMIND_NODE:-}" ]; then
  if [ -x "$HIVEMIND_NODE" ]; then
    NODE="$HIVEMIND_NODE"
  elif command -v "$HIVEMIND_NODE" >/dev/null 2>&1; then
    NODE=$(command -v "$HIVEMIND_NODE")
  fi
fi
if [ -z "$NODE" ]; then
  for candidate in node nodejs; do
    if command -v "$candidate" >/dev/null 2>&1; then
      NODE=$(command -v "$candidate")
      break
    fi
  done
fi
if [ -z "$NODE" ]; then
  echo "[hive-switch] ERROR: Node.js is required to verify model tiers before switching. Install Node >= 22, then re-run install.sh." >&2
  exit 1
fi

exec "$NODE" "$BACKEND" "$@"
